# Copia questo file in .env e riempi i valori. Il file .env è nel
# .gitignore e non va mai committato.

# --- Backend (server/) ---
# Chiave di Spoonacular, account gratuito su
# https://spoonacular.com/food-api/console
# Senza prefisso VITE_: la legge solo il server, non finisce nel browser.
SPOONACULAR_API_KEY=

# --- Frontend (build di Vite) ---
# DSN del progetto Sentry. Facoltativo: vuoto, Sentry resta spento.
VITE_SENTRY_DSN=
# Nome dell'ambiente che compare su Sentry
VITE_APP_ENV=development
